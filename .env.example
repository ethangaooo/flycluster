# FlyCluster 环境变量示例。复制为 .env 后按需修改。
# 密钥不要提交到版本库。

# ---- 开放 API 鉴权 ----
# 格式：name:key[:每分钟调用上限]，多个用逗号分隔
FLYCLUSTER_API_KEYS=local:dev-local-key:600

# ---- 脑节点 ----
BRAIN_CONNECTOME=synthetic-2000      # 或 data/male-cns-gateway.npz（真实连接组）
BRAIN_STEPS_PER_TICK=20              # 每个决策步对应的仿真毫秒数
BRAIN_MESSAGE_KIND=learned_compressed # learned_compressed | shared_observation
BRAIN_SYNAPTIC_SCALE=0.35
BRAIN_BACKGROUND=14
BRAIN_NOISE=6

# ---- 记忆 ----
# memory_scope 语义见 docs/05-api.md；禁止默认跨租户共享
BRAIN_MEMORY_SCOPE=run

# ---- 真实连接组（可选）----
# NEUPRINT_TOKEN=xxxx
# 先探测再抓取：
#   python tools/fetch_connectome.py probe --dataset male-cns:v1.0
#   python tools/fetch_connectome.py online --dataset male-cns:v1.0 --out data/male-cns-gateway.npz
